<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.platform</groupId>
    <artifactId>forwardmeasure-platform</artifactId>
    <version>1.1.0</version>
    <relativePath>../forwardmeasure-platform/pom.xml</relativePath>
  </parent>
  <groupId>com.forwardmeasure.presentation</groupId>
  <artifactId>forwardmeasure-presentation-system-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>ForwardMeasure Presentation System</name>
  <description>
    The single place for ForwardMeasure's presentation system: the shared web package every app's
    interface is built from (tokens, component styles, fonts, theme logic), and the slide templates.
    The design itself is made in the Kriyagentic design system in claude.ai and pinned here.
  </description>
  <url>https://github.com/forwardmeasure/forwardmeasure-presentation-system</url>
  <scm>
    <connection>scm:git:https://github.com/forwardmeasure/forwardmeasure-presentation-system.git</connection>
    <developerConnection>scm:git:git@github.com:forwardmeasure/forwardmeasure-presentation-system.git</developerConnection>
    <url>https://github.com/forwardmeasure/forwardmeasure-presentation-system</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/forwardmeasure/forwardmeasure-presentation-system/issues</url>
  </issueManagement>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
    <!-- Project release identity is local for Maven CI-friendly reactor parent resolution. -->
    <revision>1.1.0</revision>
  </properties>
  <modules>
    <module>forwardmeasure-presentation-system-web</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <inputExcludes combine.children="append">
            <!-- A byte-for-byte copy of the claude.ai design system (see design/SOURCE.md); it is
                 replaced whole on every sync, so it carries no header of its own. -->
            <inputExclude>**/design/**</inputExclude>
            <!-- JSON has no comment syntax. -->
            <inputExclude>**/package.json</inputExclude>
            <inputExclude>**/package-lock.json</inputExclude>
            <!-- Slide templates and their notes: binary Office files. -->
            <inputExclude>slides/**</inputExclude>
            <inputExclude>**/node_modules/**</inputExclude>
          </inputExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
